# EduPlan NG Database
DATABASE_URL="file:local.db"
DATABASE_AUTH_TOKEN=

# Auth Configuration
BETTER_AUTH_SECRET=your_auth_secret_key_here
BETTER_AUTH_URL=http://localhost:3000

# --------------------------------------------------------------------------
# KORA PAY PAYMENT GATEWAY (LIVE & TEST MODES)
# --------------------------------------------------------------------------
# Required for live payment processing and charge initialization:
# - Live key format: sk_live_...
# - Test/Sandbox key format: sk_test_...
KORA_SECRET_KEY=ks_test_sandbox_eduplan_demo

# Optional encryption key for AES card payload tokenization:
KORA_ENCRYPTION_KEY=

# Secret token used to authenticate incoming webhook HMAC SHA256 signatures:
KORA_WEBHOOK_SECRET=

# Public key for frontend elements (optional):
NEXT_PUBLIC_KORA_PUBLIC_KEY=pk_test_...
VITE_KORA_PUBLIC_KEY=pk_test_...

# Email & Notification Services
RESEND_API_KEY=
EMAIL_FROM=notifications@eduplan.ng

# Error Monitoring (Sentry)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Base URL for Webhook callbacks & payment redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
